  {
    "rule": "JEV112",
    "name": "an undefined boundary against one drawn in the criteria",
    "cases": [
      {
        "state": "Two full pallets of tiles, needs the lorry.",
        "expected": true
      },
      {
        "state": "Forty boxes on three pallets.",
        "expected": true
      },
      {
        "state": "One pallet and a few loose bags, tail lift required.",
        "expected": true
      },
      {
        "state": "A single box of screws.",
        "expected": false
      },
      {
        "state": "Three tins of paint, customer will collect.",
        "expected": false
      },
      {
        "state": "One bag of sand.",
        "expected": false
      }
    ],
    "bad": {
      "questions": {
        "q": {
          "type": "noul",
          "instructions": "Is the order large?"
        }
      },
      "decide": "noul:q"
    },
    "good": {
      "questions": {
        "q": {
          "type": "noul",
          "instructions": "Is the order large?",
          "criteria": {
            "true": "The order is at least one pallet or needs a lorry.",
            "false": "The order is loose items a person could carry."
          }
        }
      },
      "decide": "noul:q"
    }
  },
  {
    "rule": "JEV004",
    "name": "a Choice with no fallback against one with a fallback",
    "cases": [
      {
        "state": "My invoice shows the wrong amount.",
        "expected": "billing"
      },
      {
        "state": "I was charged twice this month.",
        "expected": "billing"
      },
      {
        "state": "The app crashes when I open settings.",
        "expected": "technical"
      },
      {
        "state": "Sync has been stuck for an hour.",
        "expected": "technical"
      },
      {
        "state": "Do you have any job openings?",
        "expected": "other"
      },
      {
        "state": "I would like to book a table for six.",
        "expected": "other"
      },
      {
        "state": "Where is your office?",
        "expected": "other"
      },
      {
        "state": "Can I interview your founder for a podcast?",
        "expected": "other"
      }
    ],
    "bad": {
      "questions": {
        "q": {
          "type": "choice",
          "instructions": "Which team should handle this?",
          "criteria": {
            "billing": "Charges, invoices and payment problems",
            "technical": "Faults, errors and outages"
          }
        }
      },
      "decide": "choice:q"
    },
    "good": {
      "questions": {
        "q": {
          "type": "choice",
          "instructions": "Which team should handle this?",
          "criteria": {
            "billing": "Charges, invoices and payment problems",
            "technical": "Faults, errors and outages",
            "other": "Fits none of the other options"
          }
        }
      },
      "decide": "choice:q"
    }
  }
]
