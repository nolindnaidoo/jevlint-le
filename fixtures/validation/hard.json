[
  {
    "rule": "JEV101",
    "name": "double negative, states that take reading",
    "cases": [
      {
        "state": "Packed and labelled, courier booked for tomorrow.",
        "expected": false
      },
      {
        "state": "Label printed. Waiting for the van.",
        "expected": false
      },
      {
        "state": "Handed to the courier at 9 this morning.",
        "expected": true
      },
      {
        "state": "The parcel is out for delivery.",
        "expected": true
      },
      {
        "state": "We tried to send it on Monday but the address failed validation, so it is still here.",
        "expected": false
      },
      {
        "state": "Left our warehouse yesterday; the tracking page has not updated yet.",
        "expected": true
      },
      {
        "state": "Not sent yet, sorry.",
        "expected": false
      },
      {
        "state": "It has not been held back; it went with this morning's collection.",
        "expected": true
      },
      {
        "state": "No, nothing has been dispatched on this order.",
        "expected": false
      },
      {
        "state": "Dispatch is scheduled for the 14th.",
        "expected": false
      },
      {
        "state": "The carrier scanned it at their hub an hour ago.",
        "expected": true
      },
      {
        "state": "We have not been unable to send it: it left on Tuesday.",
        "expected": true
      },
      {
        "state": "Awaiting payment before we can send anything.",
        "expected": false
      },
      {
        "state": "Delivered and signed for.",
        "expected": true
      },
      {
        "state": "It is boxed up on the loading bay.",
        "expected": false
      }
    ],
    "bad": {
      "questions": {
        "q": {
          "type": "noul",
          "instructions": "Is it not the case that the order has not shipped?"
        }
      },
      "decide": "noul:q"
    },
    "good": {
      "questions": {
        "q": {
          "type": "noul",
          "instructions": "Has the order shipped?"
        }
      },
      "decide": "noul:q"
    }
  },
