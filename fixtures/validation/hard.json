  {
    "rule": "JEV104",
    "name": "compound, where only one half holds",
    "cases": [
      {
        "state": "This is a disgrace. I want every penny back.",
        "expected": true
      },
      {
        "state": "Third time this has broken. Furious. Refund me.",
        "expected": true
      },
      {
        "state": "I'm so fed up with this, just give me my money back.",
        "expected": true
      },
      {
        "state": "Unacceptable. Refund, now.",
        "expected": true
      },
      {
        "state": "I'm furious. Fix it by Friday or I'm leaving a review.",
        "expected": false
      },
      {
        "state": "Absolutely appalling service. I never want to hear from you again.",
        "expected": false
      },
      {
        "state": "Livid. Send a replacement immediately.",
        "expected": false
      },
      {
        "state": "What a joke of a company.",
        "expected": false
      },
      {
        "state": "Hi, could I get a refund? It was a gift and they already have one. Thanks so much!",
        "expected": false
      },
      {
        "state": "No rush at all, but please refund order 22 when you can.",
        "expected": false
      },
      {
        "state": "Lovely product, just the wrong size. Refund please :)",
        "expected": false
      },
      {
        "state": "Per your returns policy I'd like my money back.",
        "expected": false
      },
      {
        "state": "Is this available in blue?",
        "expected": false
      },
      {
        "state": "Thanks, it arrived.",
        "expected": false
      }
    ],
    "bad": {
      "questions": {
        "q": {
          "type": "noul",
          "instructions": "Is the customer angry and asking for a refund?"
        }
      },
      "decide": "noul:q"
    },
    "good": {
      "questions": {
        "a": {
          "type": "noul",
          "instructions": "Is the customer angry?"
        },
        "b": {
          "type": "noul",
          "instructions": "Is the customer asking for a refund?"
        }
      },
      "decide": "and:a,b"
    }
  },
