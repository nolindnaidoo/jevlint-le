{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension on samples",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}/samples"
			],
			"outFiles": ["${workspaceFolder}/dist/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}",
			"sourceMaps": true
		}
	]
}
